// The role cards (web/style.css .role-card.big), used by setup and the
// per-channel role picker.

import { Theme } from "theme.slint";
import { Glyph } from "chrome.slint";

// What a card is: the Monitor (berry, a camera, a cat) or the Viewer (sky,
// a phone, a dog).
export enum RoleKind { monitor, viewer }

export component RoleCard inherits Rectangle {
    in property <RoleKind> kind;
    in property <string> tag;
    in property <string> line;
    in property <string> blurb;
    callback clicked();

    property <color> acc: kind == RoleKind.monitor ? Theme.berry : Theme.sky;
    property <bool> hot: touch.has-hover || focus.has-focus;

    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: hot || touch.pressed ? acc : Theme.line;
    background: touch.pressed ? Theme.panel.mix(acc, 0.87) : hot ? Theme.panel.mix(acc, 0.93) : Theme.panel;
    // A quiet lift that grows on hover: the card reads as something to press.
    drop-shadow-color: Theme.dark ? #00000040 : #3b2a3220;
    drop-shadow-blur: hot ? 16px : 6px;
    drop-shadow-offset-y: hot ? 4px : 1px;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: Theme.quick; easing: ease-out; }
    clip: true;
    accessible-role: button;
    accessible-label: tag + ". " + line + ". " + blurb;
    accessible-action-default => { clicked(); }
    forward-focus: focus;

    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The silhouette in the corner, breathing slowly; now and then a head-tilt.
    property <float> idle: Theme.still ? 0 : mod(animation-tick() / 7500ms + (kind == RoleKind.viewer ? 0.35 : 0), 1);
    critter := Path {
        x: parent.width - 12px - 62px;
        y: 12px - (idle < 0.45 ? idle / 0.45 : idle < 0.84 ? (0.84 - idle) / 0.39 : 0) * 2.5px;
        width: 62px;
        height: 62px;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.acc;
        opacity: 0.17;
        commands: root.kind == RoleKind.monitor
            ? "M16 27 L12.5 7 L29 18 Z M48 27 L51.5 7 L35 18 Z M50 35 A18 18 0 1 1 14 35 A18 18 0 1 1 50 35 Z"
            : "M16 19 C 8 23 8 45 18 47 C 21 38 19 25 22 21 Z M48 19 C 56 23 56 45 46 47 C 43 38 45 25 42 21 Z M49 33 A17 17 0 1 1 15 33 A17 17 0 1 1 49 33 Z";
        transform-origin: { x: self.width * 0.6, y: self.height * 0.8 };
        transform-rotation: idle > 0.84 && idle < 0.9 ? -5deg * (idle - 0.84) / 0.06
            : idle >= 0.9 && idle < 0.96 ? -5deg + 7deg * (idle - 0.9) / 0.06
            : idle >= 0.96 ? 2deg * (1 - idle) / 0.04 : 0deg;
    }

    HorizontalLayout {
        // Spans the card (a layout in a plain element would take its preferred size).
        width: parent.width;
        padding: 18px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            // The role's glyph, 42 px, in the card's accent. In a row of its
            // own: a fixed width in the column would cap the column's width.
            HorizontalLayout { alignment: start; Rectangle {
                height: 48px;
                width: 42px;
                if root.kind == RoleKind.monitor: Rectangle {
                    y: 0; width: 42px; height: 42px;
                    Path { viewbox-width: 48; viewbox-height: 48; fill: root.acc;
                        commands: "M15 9 H22 A3 3 0 0 1 25 12 V13 A3 3 0 0 1 22 16 H15 A3 3 0 0 1 12 13 V12 A3 3 0 0 1 15 9 Z M11 14 H37 A6 6 0 0 1 43 20 V33 A6 6 0 0 1 37 39 H11 A6 6 0 0 1 5 33 V20 A6 6 0 0 1 11 14 Z"; }
                    Path { viewbox-width: 48; viewbox-height: 48; fill: Theme.panel;
                        commands: "M32 26.5 A8 8 0 1 1 16 26.5 A8 8 0 1 1 32 26.5 Z M38.8 19.5 A1.8 1.8 0 1 1 35.2 19.5 A1.8 1.8 0 1 1 38.8 19.5 Z"; }
                    Path { viewbox-width: 48; viewbox-height: 48; fill: root.acc;
                        commands: "M28.2 26.5 A4.2 4.2 0 1 1 19.8 26.5 A4.2 4.2 0 1 1 28.2 26.5 Z"; }
                    Path { viewbox-width: 48; viewbox-height: 48; fill: Theme.panel;
                        commands: "M23.1 24.1 A1.5 1.5 0 1 1 20.1 24.1 A1.5 1.5 0 1 1 23.1 24.1 Z"; }
                }
                if root.kind == RoleKind.viewer: Rectangle {
                    y: 0; width: 42px; height: 42px;
                    Path { viewbox-width: 48; viewbox-height: 48; fill: root.acc;
                        commands: "M19 4 H29 A6 6 0 0 1 35 10 V38 A6 6 0 0 1 29 44 H19 A6 6 0 0 1 13 38 V10 A6 6 0 0 1 19 4 Z"; }
                    Path { viewbox-width: 48; viewbox-height: 48; fill: Theme.panel;
                        commands: "M19.5 9.5 H28.5 A3 3 0 0 1 31.5 12.5 V32.5 A3 3 0 0 1 28.5 35.5 H19.5 A3 3 0 0 1 16.5 32.5 V12.5 A3 3 0 0 1 19.5 9.5 Z M21.5 39.2 H26.5 A1 1 0 0 1 26.5 41.2 H21.5 A1 1 0 0 1 21.5 39.2 Z M25 6.6 A1 1 0 1 1 23 6.6 A1 1 0 1 1 25 6.6 Z"; }
                }
            } }
            Text {
                text: root.tag.to-uppercase();
                wrap: word-wrap;
                font-size: 13px;
                letter-spacing: 2.1px;
                color: root.acc;
            }
            Text {
                text: root.line;
                wrap: word-wrap;
                font-family: Theme.strong-font;
                font-size: 20px;
                color: Theme.fg;
            }
            Text {
                text: root.blurb;
                font-size: 15px;
                color: Theme.dim;
                wrap: word-wrap;
            }
        }
        // The chevron: dim, the accent on hover, a step to the right.
        Rectangle {
            width: 22px;
            horizontal-stretch: 0;
            Path {
                x: root.hot ? 5.5px : 3.5px;
                animate x { duration: Theme.quick; }
                width: 15px;
                height: 15px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Glyph.go;
                stroke: root.hot ? root.acc : Theme.dim;
                stroke-width: 2.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }
    }
    Rectangle {
        border-radius: Theme.r-card;
        border-width: focus.has-focus ? 2px : 0;
        border-color: Theme.berry;
    }
}
