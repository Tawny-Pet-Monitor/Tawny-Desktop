msgid "New channel"
msgstr "Canal nuevo"

#: ui/sheets.slint:259
msgctxt "Editor"
msgid "Name"
msgstr "Nombre"

#: ui/sheets.slint:260
msgctxt "Editor"
msgid "Living room"
msgstr "Sala"

#: ui/sheets.slint:265
msgctxt "Editor"
msgid "The key stays the same, so paired devices keep working."
msgstr "La clave no cambia, así que los dispositivos vinculados siguen funcionando."

#: ui/sheets.slint:266
msgctxt "Editor"
msgid "A fresh key is generated for this channel. Only devices you pair can join it."
msgstr "Se genera una clave nueva para este canal. Solo los dispositivos que vincules pueden unirse."

#: ui/sheets.slint:272
msgctxt "Editor"
msgid "Cancel"
msgstr "Cancelar"

#: ui/sheets.slint:277
