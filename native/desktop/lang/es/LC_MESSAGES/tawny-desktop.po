msgid "Save"
msgstr "Guardar"

#: ui/tip.slint:161
msgctxt "TipPick"
msgid "Back"
msgstr "Atrás"

#: ui/tip.slint:196
msgctxt "TipPick"
msgid "Tip in Bitcoin"
msgstr "Propina en Bitcoin"

#: ui/tip.slint:203
msgctxt "TipPick"
msgid "Over Lightning, with any wallet. Tawny stays free either way."
msgstr "Por Lightning, con cualquier billetera. Tawny sigue siendo gratis igual."

#: ui/tip.slint:214 ui/tip.slint:266
msgctxt "TipPick"
msgid "Amount"
msgstr "Monto"

#: ui/tip.slint:224
msgctxt "TipPick"
msgid "Other"
msgstr "Otro"

#: ui/tip.slint:225
msgctxt "TipPick"
msgid "any amount"
msgstr "el que quieras"

#: ui/tip.slint:275
msgctxt "TipPick"
msgid "Create code"
msgstr "Crear código"

#: ui/tip.slint:292
msgctxt "TipPick"
msgid "QR code of the Lightning invoice"
msgstr "Código QR de la factura Lightning"

#: ui/tip.slint:344
msgctxt "TipPick"
msgid "Creating your code…"
msgstr "Creando tu código…"

#: ui/tip.slint:345
msgctxt "TipPick"
msgid "Type an amount, then “Create code”."
msgstr "Escribe un monto y toca “Crear código”."

#: ui/tip.slint:346
msgctxt "TipPick"
msgid "You’re offline. Connect, then try again."
msgstr "No tienes conexión. Conéctate e inténtalo de nuevo."

#: ui/tip.slint:347
msgctxt "TipPick"
msgid "Couldn’t reach the tip service."
msgstr "No se pudo conectar con el servicio de propinas."

#: ui/tip.slint:355
msgctxt "TipPick"
msgid "Try again"
msgstr "Intentar de nuevo"

#: ui/tip.slint:380
msgctxt "TipPick"
msgid "Scan with any Bitcoin wallet on your phone"
msgstr "Escanéalo con cualquier billetera de Bitcoin en tu teléfono"

#: ui/tip.slint:400
msgctxt "TipPick"
msgid "Waiting for payment…"
msgstr "Esperando el pago…"

#: ui/tip.slint:411
msgctxt "TipPick"
msgid "No wallet? Pay on strike.me"
msgstr "¿Sin billetera? Paga en strike.me"

#: ui/tip.slint:430
msgctxt "TipPick"
msgid "Copied"
msgstr "Copiada"

#: ui/tip.slint:430
msgctxt "TipPick"
msgid "Couldn’t copy"
msgstr "No se pudo copiar"

#: ui/tip.slint:430
msgctxt "TipPick"
msgid "Copy invoice"
msgstr "Copiar factura"

#: ui/tip.slint:437
msgctxt "TipPick"
msgid "Not now"
msgstr "Ahora no"

#: ui/tip.slint:525
msgctxt "TipThanks"
msgid "Thank you!"
msgstr "¡Gracias!"

#: ui/tip.slint:553
msgctxt "TipThanks"
msgid "You’re making Tawny better for everyone."
msgstr "Haces Tawny mejor para todos."

#: ui/tip.slint:563
msgctxt "TipThanks"
msgid "Done"
msgstr "Listo"

#: ui/welcome.slint:59
msgctxt "Welcome"
msgid "Pet Monitor"
msgstr "Monitor para mascotas"

#: ui/welcome.slint:72
msgctxt "Welcome"
msgid "Keep an eye on your pet from anywhere in the house. Two phones on your Wi-Fi — no accounts, nothing to set up."
msgstr "Vigila a tu mascota desde cualquier rincón de la casa. Dos teléfonos en tu Wi-Fi: sin cuentas y sin nada que configurar."

#: ui/welcome.slint:84
msgctxt "Welcome"
msgid "Get started"
msgstr "Empezar"

#: ui/welcome.slint:85
msgctxt "Welcome"
msgid "I’ve set this up before"
msgstr "Ya lo configuré antes"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Faster and lighter"
msgstr "Más rápido y más ligero"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "No web browser inside any more: Tawny starts faster and uses less memory."
msgstr "Ya no lleva un navegador web por dentro: Tawny abre más rápido y usa menos memoria."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Calls that fix themselves"
msgstr "Llamadas que se arreglan solas"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "If the network drops, the call comes back on its own."
msgstr "Si se cae la red, la llamada vuelve sola."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Zoom where you point"
msgstr "Zoom donde apuntas"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Turn the mouse wheel over the picture, then drag to see any corner of the room."
msgstr "Gira la rueda del ratón sobre la imagen y luego arrastra para ver cualquier rincón de la habitación."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Always the right way up"
msgstr "Siempre derecho"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "An upright phone shows upright on every screen, iPhone too."
msgstr "Un teléfono vertical se ve derecho en todas las pantallas, también en iPhone."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Your channels and pairings came along."
msgstr "Tus canales y emparejamientos se conservaron."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Here’s what’s new for you and your pet."
msgstr "Esto es lo nuevo para ti y tu mascota."

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "See everything that changed"
msgstr "Ver todo lo que cambió"

#: ui/sheets2.slint
msgctxt "WhatsNewSheet"
msgid "Tawny stays free because of people like you."
msgstr "Tawny sigue siendo gratis gracias a personas como tú."
